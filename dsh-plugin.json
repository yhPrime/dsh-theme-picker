{
  "$schema": "https://dsh-standard.dev/schemas/dsh-plugin-0.15.schema.json",
  "manifestVersion": "0.15",
  "id": "dsh-theme-picker",
  "name": "主题选择器",
  "version": "1.1.0",
  "facets": {
    "host": {
      "entry": "./lib/index.js",
      "apiVersion": "v1alpha1"
    }
  },
  "contributes": {
    "x-browser": [
      {
        "id": "theme-picker-settings",
        "name": "settings",
        "apiVersion": "browser.ui.dsh/v1alpha1",
        "kind": "LocalModule",
        "spec": {
          "module": "./lib/client.js",
          "requirements": [
            {
              "apiVersion": "ui.dsh/v1alpha1",
              "kind": "ContributionHost",
              "spec": {
                "surfaces": [
                  {
                    "apiVersion": "browser.ui.dsh/v1alpha1",
                    "kind": "SettingsSection",
                    "mode": "local-module"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "license": "MIT",
  "source": {
    "repository": "https://github.com/yhPrime/dsh-theme-picker"
  }
}
